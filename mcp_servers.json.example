{
  "mcpServers": {
    "systeme": {
      "command": "python",
      "args": ["-m", "jarvis_cyber.mcp_builtin.system_server"],
      "enabled": true
    },
    "demo": {
      "command": "python",
      "args": ["examples/mcp_demo_server.py"],
      "enabled": false
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/chemin/vers/dossier"],
      "enabled": false
    }
  }
}
